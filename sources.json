{
  "_comment": "Source roots. Each entry: adapter (claude|codex|cc_transcripts), path or glob, label (use {name}/{parent} placeholders for globs), rank (lower wins canonical ties), is_test. Add new roots here; no schema change needed. Never point a root at credential directories.",
  "caps": {
    "tool_output_chars": 4096,
    "tool_args_chars": 262144,
    "injected_chars": 4096
  },
  "roots": [
    {"adapter": "claude", "path": "~/.claude", "label": "claude-home", "rank": 0},
    {"adapter": "claude", "glob": "~/.aisw/profiles/claude/*", "label": "aisw-claude-{name}", "rank": 5},
    {"adapter": "cc_transcripts", "path": "~/.claude/transcripts", "label": "claude-transcripts", "rank": 0},

    {"adapter": "codex", "path": "~/.codex", "label": "codex-home", "rank": 0},
    {"adapter": "codex", "path": "~/AppData/Roaming/orca/codex-runtime-home/home", "label": "orca-runtime", "rank": 1},
    {"adapter": "codex", "glob": "~/AppData/Roaming/orca/codex-accounts/*/home", "label": "orca-acct-{parent8}", "rank": 2},
    {"adapter": "codex", "path": "~/.ultra-codex", "label": "ultra-codex", "rank": 3},
    {"adapter": "codex", "glob": "~/.aisw/profiles/codex/*", "label": "aisw-codex-{name}", "rank": 4},
    {"adapter": "codex", "glob": "~/.agentryx/agents/*/session", "label": "agentryx-agent-{parent8}", "rank": 8, "is_test": true},
    {"adapter": "codex", "glob": "~/research/codex-session-status/probe-*/home", "label": "{parent}", "rank": 9, "is_test": true}
  ],
  "skip_path_substrings": ["recovery-backups"]
}
